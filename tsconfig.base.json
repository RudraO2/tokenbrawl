{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@tokenbrawl/contracts": ["./docs/contracts/index.ts"]
    }
  },
  "include": [
    "docs/contracts/**/*.ts",
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts"
  ]
}

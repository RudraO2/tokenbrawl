# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Vendored BMad agent skills — reinstallable tooling, ~4.8MB of noise in a
# repo meant to showcase the product. Kept on disk, out of Git.
# `_bmad/` (config + scripts) and `_bmad-output/` (planning artifacts) ARE committed.
.agents/
.claude/skills/

# Test and coverage output
coverage/
.nyc_output/
*.lcov


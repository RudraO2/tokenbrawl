# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment and secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# BMad tooling and its planning artifacts — the scaffolding this project was
# built WITH, not the project itself. Kept on disk (the sprint status and specs
# are how work resumes between sessions) and out of Git: a repo meant to
# showcase the product should contain the product.
#
# Reversed a deliberate earlier decision to commit `_bmad/` and `_bmad-output/`.
# They were purged from history before the first push; if you need them on
# another machine, copy the directories across rather than committing them.
.agents/
.claude/skills/
_bmad/
_bmad-output/
PROMPT.md
ralph-loop.md

# Test and coverage output
coverage/
.nyc_output/
*.lcov

# Logs
*.log
npm-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Scratch
tmp/
.tmp/
scratch/
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml

# Personal BMad settings — not shared
_bmad/config.user.yaml
.bmad-loop/archive/

# Story 9.1 / AD-16 — dev-only pointer to the local Extraction reference
# project, populated on a developer's own machine with paths outside this
# repository. Never committed: the .gitignore entry and the mechanism that
# reads it land in the same change, and a test asserts this file is absent
# from the current `git ls-files` output.
apps/web/sprites.local.json
